{
  "name": "basovoe-syrovarenie",
  "productName": "Басовое космическое сыроварение",
  "version": "0.2.0",
  "description": "Колба на рабочем столе, в которой бас варит зелья и сыры",
  "private": true,
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "gift.bass.cheese",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "Basovoe-syrovarenie.exe"
    }
  }
}
